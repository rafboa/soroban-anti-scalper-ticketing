# StellarPass Frontend Environment Variables Template
# Copy this file to .env.local and populate with your own deployment values

NEXT_PUBLIC_CONTRACT_ID=<YOUR_DEPLOYED_CONTRACT_ID>
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_FACE_VALUE=100
NEXT_PUBLIC_MAX_MULT=110
NEXT_PUBLIC_TOKEN_ADDRESS=<YOUR_PAYMENT_TOKEN_CONTRACT_ADDRESS>

# Optional: Set a public key here to preview UI without connecting Freighter
# NEXT_PUBLIC_DEV_WALLET=<PUBLIC_STELLAR_ADDRESS>
